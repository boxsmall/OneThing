<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Cloud backup is intentionally disabled for V1. Device-to-device
         transfer is configured in data_extraction_rules.xml on Android 12+. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
